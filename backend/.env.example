# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=marketplace_db

# JWT
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_MINUTES=20
CATALOG_CACHE_TTL_MINUTES=20
SEARCH_CACHE_TTL_MINUTES=10
ORG_PRODUCTS_CACHE_TTL_MINUTES=15
REDIS_URL=redis://redis:6379
CART_TTL_MINUTES=20

# Frontend
FRONTEND_URL=http://localhost:3001

# Application
PORT=3000
NODE_ENV=development
LOW_STOCK_THRESHOLD=5

# OpenAI
OPENAI_API_KEY=super_secret_openai_api_key
AI_TIMEOUT_MS=5000